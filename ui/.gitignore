# Logs
# Anchored to the ui root so it doesn't also ignore source paths that happen
# to contain a "logs" segment (e.g. src/pages/strength/logs/).
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Capacitor
ios/App/Pods

# Tauri
src-tauri/binaries/
src-tauri/target/

# Electron
electron/binaries/
dist-electron/
